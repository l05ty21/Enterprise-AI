# 生产环境变量模板：复制为 .env 后按需修改
# cd deploy && cp .env.example .env

# ---------- 必改 ----------
SECRET_KEY=please-generate-with-openssl-rand-hex-32
MYSQL_ROOT_PASSWORD=change-this-strong-password

# ---------- 业务 ----------
CORS_ORIGINS=https://your-domain.com
FIRST_ORG_CODE=demo
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_PASSWORD=ChangeMe@2026

# ---------- 对象存储 ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---------- AI 模型（第二阶段） ----------
# 平台级兜底 Key：企业没在后台配模型时使用
AI_DEFAULT_PROVIDER=bailian
AI_DEFAULT_MODEL=qwen-plus
AI_CLOUD_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_CLOUD_API_KEY=
AI_EMBEDDING_MODEL=text-embedding-v3
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_MAX_TOKENS=2048
# 企业 API Key 的加密密钥，务必与 SECRET_KEY 分开：openssl rand -hex 32
AI_KEY_ENCRYPTION_KEY=

# 提示：
#   * 生产环境不要映射 3306 / 6379 / 19530 到公网
#   * SECRET_KEY 一旦泄露，所有已签发的 JWT 都需要作废
#   * 首次启动 backend 容器会自动执行 alembic upgrade head 和种子脚本
