# ---------- 应用 ----------
APP_NAME=智企协同 Enterprise AI
APP_ENV=dev
DEBUG=true
LOG_LEVEL=INFO

# ---------- 安全 ----------
# 生产环境必须替换：openssl rand -hex 32
SECRET_KEY=dev-only-secret-change-me-0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- 数据库 ----------
# 本地 MySQL 8.0（库需要先建好：CREATE DATABASE enterprise_ai CHARACTER SET utf8mb4;）
DATABASE_URL=mysql+asyncmy://root:root@127.0.0.1:3306/enterprise_ai?charset=utf8mb4
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
# 仅本地体验用，生产请保持 false 并用 alembic 管理表结构
AUTO_CREATE_TABLES=false

# ---------- 缓存 / 队列 ----------
# 不填则使用进程内令牌黑名单（仅适合单实例开发）
REDIS_URL=redis://127.0.0.1:6379/0

# ---------- 跨域 ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 初始化数据 ----------
FIRST_ORG_NAME=示例科技有限公司
FIRST_ORG_CODE=demo
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_PASSWORD=Admin@123456
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_REAL_NAME=系统管理员

# ---------- AI 模型接入 ----------
# provider 决定默认端点：bailian(百炼) / deepseek / siliconflow / zhipu / openai / ollama
AI_DEFAULT_PROVIDER=bailian
AI_DEFAULT_MODEL=qwen-plus
AI_CLOUD_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_CLOUD_API_KEY=
AI_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
AI_EMBEDDING_MODEL=text-embedding-v3
# 单次调用约束
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_MAX_TOKENS=2048
# 企业 API Key 的加密密钥（openssl rand -hex 32）；留空则用 SECRET_KEY 派生
AI_KEY_ENCRYPTION_KEY=
